// Vishvakarma Hub - Database Schema
// Full-scale startup creation and public funding platform

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  USER
  FOUNDER
  ADMIN
}

enum StartupStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum ProductStage {
  IDEA
  CONCEPT
  PROTOTYPE
  MVP
  BETA
  LAUNCHED
  GROWTH
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  RAZORPAY
  STRIPE
}

enum DocumentType {
  INCORPORATION_CERTIFICATE
  FOUNDER_ID
  BANK_PROOF
  COMPANY_REGISTRATION
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CAMPAIGN_UPDATE
  MILESTONE_COMPLETION
  FUNDING_SUCCESS
  NEW_STARTUP
  CONTRIBUTION_RECEIVED
  WITHDRAWAL
  SYSTEM
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ==================== MODELS ====================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  avatar          String?
  bio             String?
  linkedIn        String?
  phone           String?
  role            Role      @default(USER)
  emailVerified   Boolean   @default(false)
  isActive        Boolean   @default(true)
  verifyToken     String?
  resetToken      String?
  resetTokenExpiry DateTime?
  referralCode    String?   @unique
  referredBy      String?
  referralCount   Int       @default(0)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  startups        Startup[]
  contributions   Contribution[]
  comments        Comment[]
  notifications   Notification[]
  savedStartups   SavedStartup[]
  withdrawals     Withdrawal[]
  cofounderApplications CofounderApplication[]
  competitionEntries CompetitionEntry[]
  competitionVotes  CompetitionVote[]

  @@index([email])
  @@index([referralCode])
  @@map("users")
}

model Startup {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  shortDescription String
  problemDescription String     @db.Text
  targetAudience  String
  solutionExplanation String    @db.Text
  innovationUniqueness String   @db.Text
  category        String
  location        String
  productStage    ProductStage  @default(IDEA)
  status          StartupStatus @default(DRAFT)
  logo            String?
  thumbnail       String?
  pitchDeck       String?
  demoVideo       String?
  screenshots     String[]
  aiScore         Int?
  marketPotential String?
  executionRisk   String?
  startupPotential Int?
  lookingForCofounder Boolean @default(false)
  cofounderRoles  String[]
  isFeatured      Boolean @default(false)
  
  founderId       String
  founder         User          @relation(fields: [founderId], references: [id])
  
  campaign        Campaign?
  documents       Document[]
  milestones      Milestone[]
  comments        Comment[]
  savedBy         SavedStartup[]
  cofounderApplications CofounderApplication[]
  competitionEntries CompetitionEntry[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([founderId])
  @@map("startups")
}

model Campaign {
  id              String         @id @default(cuid())
  fundingGoal     Float
  raisedAmount    Float          @default(0)
  supporterCount  Int            @default(0)
  startDate       DateTime       @default(now())
  endDate         DateTime
  status          CampaignStatus @default(DRAFT)
  
  startupId       String         @unique
  startup         Startup        @relation(fields: [startupId], references: [id])
  
  rewardTiers     RewardTier[]
  contributions   Contribution[]
  withdrawals     Withdrawal[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@map("campaigns")
}

model RewardTier {
  id              String    @id @default(cuid())
  name            String
  amount          Float
  description     String
  maxClaims       Int?
  claimedCount    Int       @default(0)
  
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id])
  
  contributions   Contribution[]
  
  @@map("reward_tiers")
}

model Contribution {
  id              String             @id @default(cuid())
  amount          Float
  paymentMethod   PaymentMethod
  transactionId   String?
  status          ContributionStatus @default(PENDING)
  
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  
  campaignId      String
  campaign        Campaign           @relation(fields: [campaignId], references: [id])
  
  rewardTierId    String?
  rewardTier      RewardTier?        @relation(fields: [rewardTierId], references: [id])
  
  createdAt       DateTime           @default(now())

  @@index([userId])
  @@index([campaignId])
  @@map("contributions")
}

model Document {
  id              String         @id @default(cuid())
  type            DocumentType
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  reviewNote      String?
  
  startupId       String
  startup         Startup        @relation(fields: [startupId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("documents")
}

model Milestone {
  id              String          @id @default(cuid())
  title           String
  description     String
  status          MilestoneStatus @default(PENDING)
  targetDate      DateTime?
  completedDate   DateTime?
  
  startupId       String
  startup         Startup         @relation(fields: [startupId], references: [id])
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("milestones")
}

model Comment {
  id              String    @id @default(cuid())
  content         String    @db.Text
  
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  
  startupId       String
  startup         Startup   @relation(fields: [startupId], references: [id])
  
  parentId        String?
  parent          Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startupId])
  @@map("comments")
}

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  read            Boolean          @default(false)
  link            String?
  
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model SavedStartup {
  id              String    @id @default(cuid())
  
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  
  startupId       String
  startup         Startup   @relation(fields: [startupId], references: [id])
  
  createdAt       DateTime  @default(now())

  @@unique([userId, startupId])
  @@map("saved_startups")
}

model Withdrawal {
  id              String           @id @default(cuid())
  amount          Float
  status          WithdrawalStatus @default(PENDING)
  bankName        String
  accountNumber   String
  ifscCode        String
  accountHolder   String
  note            String?
  adminNote       String?
  processedAt     DateTime?
  
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  
  campaignId      String
  campaign        Campaign         @relation(fields: [campaignId], references: [id])
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

enum CofounderApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CofounderApplication {
  id              String                     @id @default(cuid())
  role            String
  message         String                     @db.Text
  experience      String                     @db.Text
  portfolio       String?
  linkedIn        String?
  status          CofounderApplicationStatus  @default(PENDING)

  applicantId     String
  applicant       User                       @relation(fields: [applicantId], references: [id])

  startupId       String
  startup         Startup                    @relation(fields: [startupId], references: [id])

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([applicantId, startupId])
  @@index([startupId])
  @@index([applicantId])
  @@map("cofounder_applications")
}

model ContactSubmission {
  id              String   @id @default(cuid())
  name            String
  email           String
  subject         String
  message         String
  isRead          Boolean  @default(false)
  adminNote       String?
  createdAt       DateTime @default(now())

  @@index([isRead])
  @@map("contact_submissions")
}

// ==================== SITE SETTINGS ====================

model SiteSettings {
  id                String   @id @default("global")
  comingSoon        Boolean  @default(false)
  razorpayKeyId     String?
  razorpayKeySecret String?
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}

// ==================== COMPETITION ====================

enum CompetitionPhase {
  REGISTRATION
  SCREENING
  VOTING
  FINALS
  COMPLETED
}

enum CompetitionEntryStatus {
  SUBMITTED
  SHORTLISTED
  SELECTED_TOP200
  PUBLIC_VOTING
  FINALIST
  WINNER
  ELIMINATED
}

model Competition {
  id              String            @id @default(cuid())
  name            String
  tagline         String
  slug            String            @unique
  description     String            @db.Text
  currentPhase    CompetitionPhase  @default(REGISTRATION)

  registrationStart DateTime
  registrationEnd   DateTime
  screeningEnd      DateTime
  votingEnd         DateTime
  finalsDate        DateTime

  // Participation fees
  studentFee        Float             @default(199)
  founderFee        Float             @default(499)

  // Exhibition booths
  boothPrice        Float             @default(5000)
  boothDescription  String?           @db.Text

  // Editable page content (JSON blob for all static text on the competition page)
  pageContent       Json?

  isActive        Boolean           @default(true)
  entries         CompetitionEntry[]
  judges          CompetitionJudge[]
  sponsors        CompetitionSponsor[]
  citizenPasses   CitizenPass[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("competitions")
}

model CompetitionSponsor {
  id              String   @id @default(cuid())
  tier            String   // TITLE, GOLD, STARTUP_PARTNER
  name            String
  logo            String?
  price           Float
  benefits        String   @db.Text  // JSON array of benefit strings

  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id])

  createdAt       DateTime @default(now())

  @@map("competition_sponsors")
}

model CompetitionEntry {
  id              String                   @id @default(cuid())
  status          CompetitionEntryStatus   @default(SUBMITTED)
  
  // Registration payment
  registrationType    String?              // STUDENT or FOUNDER
  registrationFee     Float?
  paymentStatus       String?              @default("PENDING") // PENDING, PAID, FAILED
  razorpayOrderId     String?
  razorpayPaymentId   String?

  // Screening scores
  innovationScore     Float?
  marketScore         Float?
  executionScore      Float?
  impactScore         Float?
  totalScore          Float?
  juryNotes           String?              @db.Text

  // Public voting
  upvotes             Int                  @default(0)
  
  // Finals
  pitchDate           DateTime?
  finalRank           Int?

  startupId       String
  startup         Startup                  @relation(fields: [startupId], references: [id])

  competitionId   String
  competition     Competition              @relation(fields: [competitionId], references: [id])

  userId          String
  user            User                     @relation(fields: [userId], references: [id])

  votes           CompetitionVote[]

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([startupId, competitionId])
  @@index([competitionId])
  @@index([status])
  @@map("competition_entries")
}

model CompetitionJudge {
  id              String   @id @default(cuid())
  name            String
  title           String
  organization    String
  avatar          String?
  
  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id])

  createdAt       DateTime @default(now())

  @@map("competition_judges")
}

model CompetitionVote {
  id              String   @id @default(cuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  entryId         String
  entry           CompetitionEntry @relation(fields: [entryId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, entryId])
  @@index([entryId])
  @@map("competition_votes")
}

model CitizenPass {
  id              String   @id @default(cuid())
  passNumber      String   @unique           // Unique pass number e.g. VH-2026-000001
  name            String
  phone           String
  email           String?
  idProofType     String                     // AADHAAR, PAN, VOTER
  idProofNumber   String
  fee             Float    @default(99)
  paymentStatus   String   @default("PENDING") // PENDING, PAID, FAILED
  razorpayOrderId String?
  razorpayPaymentId String?

  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id])

  createdAt       DateTime @default(now())

  @@index([competitionId])
  @@index([passNumber])
  @@map("citizen_passes")
}
